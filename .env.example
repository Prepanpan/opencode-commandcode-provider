COMMANDCODE_API_KEY=your_api_key_here

# 构建产物拉取列表覆盖（逗号分隔，整列表替换），可选；优先级 config > env > 默认列表
# COMMANDCODE_MODELS_URLS=https://a.example/models.json,https://b.example/models.json

# ZDR（零数据保留）开关，可选；config（v2 settings.zdr / v1 options.zdr）优先，默认关闭
# 注意：ZDR 采用上游透传定价，单价通常高于常规请求
# COMMANDCODE_ZDR=1

# 抓包工具（capture/）的输出目录，可选（默认 ~/.cc-capture，不进仓库）
# CC_CAPTURE_DIR=~/.cc-capture